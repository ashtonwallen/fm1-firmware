expect preset 1
expect amb 20
expect eff13 30
wait 4000
peakreset
wait 3000
expect peak_db_min -70
expect peak_db_max -10
spin K4 -30
wait 500
said Rain Off
expect amb 0
expect eff13 0
wait 15000
peakreset
wait 2000
expect peak_db_max -100
spin K4 30
wait 500
expect amb 25
expect eff13 37
wait 4000
peakreset
wait 4000
expect peak_db_max -6
spin K4 -5
wait 500
expect amb 20
