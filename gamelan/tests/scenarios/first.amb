# a first look and listen: it plays from power-on, the buka then the gong, the cycle on the screen
wav first.wav
wait 300
expect playing 1
expect preset 0
wait 8000
shot buka.png
expect gongs >0
wait 40000
shot gamelan.png
expect strokes >100
wavstop
expect peak_db_max -1
expect peak_db_min -40
tap ENV
wait 100
shot mix.png
tap ARP
wait 100
shot colour.png
tap GLO
wait 100
shot setup.png
# SELECT steps through the pages, back to the first
turn SELECT -3 100
expect view 0
press OCT+
wait 1000
shot help.png
release OCT+
