# every cave makes sound: PRESETS steps through all twelve; each rings within seconds, under -1 dBFS
master 4096
wait 300
expect style 0
peakreset
wait 15000
expect peak_db_min -40
expect peak_db_max -1
shot cave-00.png
turn PRESET 1
wait 3000
expect style 1
peakreset
wait 15000
expect peak_db_min -40
expect peak_db_max -1
shot cave-01.png
turn PRESET 1
wait 3000
expect style 2
peakreset
wait 15000
expect peak_db_min -40
expect peak_db_max -1
shot cave-02.png
turn PRESET 1
wait 3000
expect style 3
peakreset
wait 15000
expect peak_db_min -40
expect peak_db_max -1
shot cave-03.png
turn PRESET 1
wait 3000
expect style 4
peakreset
wait 15000
expect peak_db_min -40
expect peak_db_max -1
shot cave-04.png
turn PRESET 1
wait 3000
expect style 5
peakreset
wait 15000
expect peak_db_min -40
expect peak_db_max -1
shot cave-05.png
turn PRESET 1
wait 3000
expect style 6
peakreset
wait 15000
expect peak_db_min -40
expect peak_db_max -1
shot cave-06.png
turn PRESET 1
wait 3000
expect style 7
peakreset
wait 15000
expect peak_db_min -40
expect peak_db_max -1
shot cave-07.png
turn PRESET 1
wait 3000
expect style 8
peakreset
wait 15000
expect peak_db_min -40
expect peak_db_max -1
shot cave-08.png
turn PRESET 1
wait 3000
expect style 9
peakreset
wait 15000
expect peak_db_min -40
expect peak_db_max -1
shot cave-09.png
turn PRESET 1
wait 3000
expect style 10
peakreset
wait 15000
expect peak_db_min -40
expect peak_db_max -1
shot cave-10.png
turn PRESET 1
wait 3000
expect style 11
peakreset
wait 15000
expect peak_db_min -40
expect peak_db_max -1
shot cave-11.png
# and round again to the first; each cave keeps its own settings and its own world
turn PRESET 1
wait 3000
expect style 0
spin K1 -8
wait 200
expect par0 42
turn PRESET 1
wait 3000
expect style 1
expect par0 45
turn PRESET -1
wait 3000
expect style 0
expect par0 42
expect world1 >-1
