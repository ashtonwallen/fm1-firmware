# the controls: the knobs, PLAY, EDIT (the river moves on), the keys (pebbles), the octave, ALGORITHM, SAVE held
master 4096
wait 2000
# the cave page's knobs: drips, ring, river, ambience
spin K1 10
spin K2 -10
spin K3 4
spin K4 30
wait 300
expect par0 60
expect par1 50
expect par2 49
expect par3 70
expect dirty 1
shot knobs.png
# the space page
tap ENV
spin K1 -20
wait 200
expect par4 50
# PLAY: resting, what rings rings away, then silence; again: it plays on
tap PLAY
wait 30000
expect playing 0
peakreset
wait 1500
expect peak_db_max -70
shot resting.png
tap PLAY
wait 3000
expect playing 1
# EDIT: the river moves on to its next harmony
expect harm 0
tap EDIT
wait 500
expect harm 1
# the keys drop pebbles, even resting
tap PLAY
wait 30000
peakreset
key 10 down
wait 300
key 10 up
expect peak_db_min -50
tap OCT+
wait 50
expect oct 3
tap OCT-
tap OCT-
tap OCT-
tap OCT-
wait 50
expect oct 0
tap OCT-
wait 50
expect oct 0
tap PLAY
wait 500
expect playing 1
# Ambience off: the water bed gone, the music on
tap HOME
spin ALGO -100
wait 200
expect par3 0
peakreset
wait 5000
expect peak_db_min -50
# Events none: the world runs on with nothing happening
tap GLO
spin K2 -100
wait 200
expect par9 0
ff 600
wait 1000
expect floods 0
expect stones 0
# SAVE held: the cave's knobs back to its recipe
press SAVE
wait 1800
release SAVE
wait 100
expect par0 50
expect par3 40
expect par9 50
