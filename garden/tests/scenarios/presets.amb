tap ENV
wait 300
shot sound.png
tap HOME
press LFO
wait 1200
shot help.png
release LFO
expect preset 11
# kept as a setting (5 minutes after the last save at most)
wait 310000
expect dirty 0
reboot
wait 300
expect preset 11
# 1.0's project: the garden whole, the sound Cottage
tap LFO
expect preset 12
storev1
reboot
expect same 1
expect format 2
expect preset 0
wait 300
expect playing 1
peakreset
wait 20000
expect peak_db_min -35
# a long run at the loud end (Moonlight's shimmer and lead, then Sundial's kalimba), never clipping
tap LFO
tap LFO
expect preset 2
peakreset
wait 600000
expect peak_db_max -0.5
expect peak_db_min -40
tap SEL
tap SEL
tap SEL
expect preset 12
peakreset
wait 600000
