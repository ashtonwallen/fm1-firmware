# a first look and listen: a new garden plays from power-on (three starters), the gardener gets to work
wav first.wav
wait 300
expect playing 1
expect living 3
expect stage4 1
shot start.png
wait 20000
expect rung >3
shot garden20.png
wait 60000
expect tended >0
shot garden80.png
wavstop
expect peak_db_max -0.5
expect peak_db_min -30
tap ENV
wait 200
shot sound.png
tap GLO
wait 200
shot setup.png
tap SEQ
wait 200
shot ledger.png
tap HOME
wait 200
expect view 0
# the widest event line fits
longest
wait 300
shot longest.png
