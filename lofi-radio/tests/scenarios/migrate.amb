# a LOFI RADIO 1.0 save (format 1): the style, its settings, Length, the lights, the octave and where the radio is
# all carried over; the next save is format 2
storev1
reboot
wait 500
expect style 3
expect par0 60
expect par3 90
expect par10 3
expect slot3p0 60
expect slot0p1 77
expect leds 2
expect oct 3
expect track 8
expect playing 1
wait 8000
expect beats >4
tap SAVE
wait 300
expect dirty 0
reboot
wait 500
expect style 3
expect par0 60
expect slot0p1 77
expect track >8
