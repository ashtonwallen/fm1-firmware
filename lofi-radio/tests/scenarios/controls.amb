# the controls: the knobs, PLAY, EDIT (next track), REC (repeat), the keys, the octave, ALGORITHM, SAVE held
master 4096
wait 2000
expect track 1
# the radio page's knobs: swing, dust, tempo, mood
spin K1 10
spin K2 -10
spin K3 4
spin K4 30
wait 300
expect par0 55
expect par1 25
expect par2 84
expect par3 70
expect dirty 1
shot knobs.png
# tempo follows at once
wait 3000
expect bpm >80
# the mix page
tap ENV
spin K1 -20
wait 200
expect par4 50
# PLAY: the needle up, silence; again: it plays on
tap PLAY
wait 2500
expect playing 0
expect needle <5
peakreset
wait 1500
expect peak_db_max -70
shot paused.png
tap PLAY
wait 3000
expect playing 1
expect needle >90
# EDIT: the next track within a few seconds
tap EDIT
wait 4500
expect track 2
expect trackms <3000
# the keys play along, even paused
tap PLAY
wait 3000
peakreset
key 10 down
wait 300
key 10 up
expect peak_db_min -50
tap OCT+
wait 50
expect oct 3
tap OCT-
tap OCT-
tap OCT-
tap OCT-
wait 50
expect oct 0
tap OCT-
wait 50
expect oct 0
tap PLAY
wait 500
# REC: repeat; the track plays on past its end
tap REC
wait 100
expect repeat 1
tap GLO
spin K3 -5
wait 200
expect par10 0
wait 200000
expect track 2
shot repeat.png
tap REC
wait 100
expect repeat 0
# ALGORITHM: tone, from any page
tap HOME
spin ALGO -20
wait 200
expect par8 35
# SAVE held: the style back to its recipe
press SAVE
wait 1800
release SAVE
wait 100
expect par0 45
expect par2 80
