# state survives a power-off: the band and its knobs, the lights, the keys' octave, and where the set is
master 4096
wait 500
turn PRESET 2
wait 300
expect style 2
spin K1 -12
spin K4 20
tap OCT+
tap GLO
spin K4 1
wait 300
expect par0 46
expect par3 68
expect leds 2
tap SAVE
wait 300
expect dirty 0
reboot
wait 500
expect style 2
expect par0 46
expect par3 68
expect oct 3
expect leds 2
expect playing 1
expect slot0p0 50
# the set goes on: the next tune after the one that was playing
expect tune >1
# by itself: a change saves once the knobs rest, at a quiet moment (between tunes), at most every 5 minutes
spin K1 3
wait 900000
expect dirty 0
expect store_writes >1
reboot
wait 500
expect style 2
expect par0 49
# where the set is: kept at most hourly
wait 3700000
reboot
wait 500
expect tune >6
