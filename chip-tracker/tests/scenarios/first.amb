# a first look and listen: it plays from power-on, with no touch; the pages; the help cards
wav first.wav
wait 300
expect playing 1
expect song 1
wait 3000
shot intro.png
wait 20000
shot tracker.png
expect rows >40
expect vu >5
wavstop
expect peak_db_max -1
expect peak_db_min -40
tap ENV
wait 100
expect view 1
shot mix.png
tap GLO
wait 100
expect view 2
shot song.png
turn SELECT -5 100
expect view 0
tap HOME
wait 100
expect view 0
# a help card: hold a button
press REC
wait 1200
expect help 12
shot help.png
release REC
wait 100
expect help 0
expect repeat 0
wait 3000
shot later.png
