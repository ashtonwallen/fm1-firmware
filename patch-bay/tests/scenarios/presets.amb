# every preset makes sound by itself, in its own key and tempo, and stays musical
master 4096
wait 300
expect preset 0
expect musical 1
wait 4000
peakreset
wait 8000
expect level >15
expect peak_db_max -1
expect peak_db_min -24
shot p0.png
turn PRESET 1
expect preset 1
expect musical 1
wait 4000
peakreset
wait 8000
expect level >15
expect peak_db_max -1
expect peak_db_min -24
