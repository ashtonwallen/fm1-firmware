# another firmware's save (AMB-1 Drift's project), or this one's of an unknown format: the defaults, playing; 1.0's save
# (fourteen styles) carries over into 1.1's thirty
storeamb
reboot
wait 500
expect style 0
expect par0 66
expect par2 55
expect leds 1
expect oct 2
expect track 1
expect playing 1
wait 8000
expect notes >4
storejunk
reboot
wait 500
expect style 0
expect track 1
expect playing 1
storev1
reboot
wait 500
expect style 12
expect par0 44
expect slot12p0 44
expect par10 3
expect oct 4
expect leds 2
expect track >40
expect playing 1
expect slot20p0 58
turn PRESET 8
wait 3000
expect style 20
expect par0 58
