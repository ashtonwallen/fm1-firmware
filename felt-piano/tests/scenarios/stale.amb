# another firmware's save (AMB-1 Drift's project), or this one's of an unknown format: the defaults, playing; 1.0's save
# (fourteen styles) and 1.1's (thirty) carry over into 1.2's thirty-three
storeamb
reboot
wait 500
expect style 0
expect par0 66
expect par2 55
expect leds 1
expect oct 2
expect track 1
expect playing 1
wait 8000
expect notes >4
storejunk
reboot
wait 500
expect style 0
expect track 1
expect playing 1
storev1
reboot
wait 500
expect style 12
expect par0 44
expect slot12p0 44
expect par10 3
expect oct 4
expect leds 2
expect track >40
expect playing 1
expect slot20p0 58
turn PRESET 8
wait 3000
expect style 20
expect par0 58
storev2
reboot
wait 500
expect style 29
expect par0 61
expect slot29p0 61
expect par10 2
expect oct 1
expect leds 0
expect track >70
expect playing 1
expect slot31p0 44
turn PRESET 2
wait 3000
expect style 31
expect par0 44
