# the controls: the knobs, PLAY, EDIT (next piece), REC (repeat), the keys, the octave, ALGORITHM, SAVE held
master 4096
wait 2000
expect track 1
# the piece page's knobs: tempo, density, felt, room
spin K1 10
spin K2 -10
spin K3 4
spin K4 30
wait 300
expect par0 76
expect par1 25
expect par2 59
expect par3 75
expect dirty 1
shot knobs.png
# the touch page
tap ENV
spin K1 -20
wait 200
expect par4 30
# PLAY: resting, the strings damped, silence; again: it plays on
tap PLAY
wait 2500
expect playing 0
peakreset
wait 1500
expect peak_db_max -70
shot paused.png
tap PLAY
wait 3000
expect playing 1
# EDIT: the next piece within a few seconds, at the new tempo
tap EDIT
wait 5000
expect track 2
expect trackms <3000
expect bpm >60
# the keys play along, even resting
tap PLAY
wait 3000
peakreset
key 10 down
wait 300
key 10 up
expect peak_db_min -50
tap OCT+
wait 50
expect oct 3
tap OCT-
tap OCT-
tap OCT-
tap OCT-
wait 50
expect oct 0
tap OCT-
wait 50
expect oct 0
tap PLAY
wait 500
# REC: repeat; the piece plays on past its end
tap REC
wait 100
expect repeat 1
tap GLO
spin K3 -5
wait 200
expect par10 0
wait 200000
expect track 2
shot repeat.png
tap REC
wait 100
expect repeat 0
# ALGORITHM: felt, from any page
tap HOME
spin ALGO -20
wait 200
expect par2 39
# SAVE held: the style back to its recipe
press SAVE
wait 1800
release SAVE
wait 100
expect par0 66
expect par2 55
