# round again, and back
tap LFO
expect preset 0
expect sent22 <2
expect sent32 0
tap SEL
expect preset 12
tap SEL
expect preset 11
tap FX
wait 300
shot mix.png
tap HOME
press LFO
wait 1200
shot help.png
release LFO
expect preset 11
# kept as a setting (5 minutes after the last save at most)
wait 310000
expect dirty 0
reboot
wait 500
expect preset 11
expect fish >2
# 1.0's project: the pond whole, the sound Mill Pond
tap LFO
expect preset 12
storev1
reboot
wait 500
expect format 2
expect preset 0
expect same 1
expect busy 50
expect playing 1
peakreset
wait 20000
expect peak_db_min -35
# a long run at the loud end (Lily Night's shimmer and lead, by night), never clipping
tap LFO
tap LFO
night
wait 3000
peakreset
wait 600000
expect peak_db_max -0.5
expect peak_db_min -40
# another firmware's data: a new pond, Mill Pond
storeamb
reboot
wait 500
expect preset 0
expect day 1
