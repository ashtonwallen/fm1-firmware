# PRESETS (1.1, LFO next / SEL last): thirteen palettes for the pond. Each makes sound, none clips; switching keeps
# the pond (the fish, their notes and ties, the day, the journal); the preset is kept as a setting; 1.0's project
# (format 1) loads whole, as Mill Pond
wait 1000
ff 120
expect day 6
expect preset 0
snap
# Mill Pond
expect preset 0
wait 4000
peakreset
wait 25000
expect peak_db_max -1
expect peak_db_min -35
expect fishsame 1
expect fish >2
# Koi Garden
tap LFO
expect preset 1
wait 300
shot preset.png
# Koi Garden: the key a fourth up (D to G), the summer's Ionian made pentatonic, the kalimba
expect sent19 7
expect sent20 6
expect sent28 >40
wait 4000
peakreset
wait 25000
expect peak_db_max -1
expect peak_db_min -35
expect fishsame 1
expect fish >2
# Lily Night
tap LFO
expect preset 2
wait 4000
peakreset
wait 25000
expect peak_db_max -1
expect peak_db_min -35
expect fishsame 1
expect fish >2
# Mountain Tarn
tap LFO
expect preset 3
# Mountain Tarn: the strings pad, the wind
expect sent22 2
expect sent36 1
expect sent37 >30
wait 4000
peakreset
wait 25000
expect peak_db_max -1
expect peak_db_min -35
expect fishsame 1
expect fish >2
