# the controls: the knobs, PLAY, EDIT (on through the day), REC (hold), the keys (a kite up), the octave,
# ALGORITHM (Ambience), SAVE held
master 4096
wait 2000
expect playing 1
# the hill page's knobs: wind, kites, ambience, space
spin K1 10
spin K2 -1
spin K3 4
spin K4 30
wait 300
expect par0 60
expect par1 3
expect par8 54
expect par2 75
expect dirty 1
shot knobs.png
# the line page
tap ENV
spin K1 -20
wait 200
expect par3 30
# PLAY: resting, silence; again: it plays on
tap PLAY
wait 3000
expect playing 0
peakreset
wait 1500
expect peak_db_max -70
shot resting.png
tap PLAY
wait 3000
expect playing 1
# EDIT: on to the next part of the day
expect phase 1
tap EDIT
wait 500
expect phase 2
# the keys: a kite goes up on the note
wait 5000
key 10 down
wait 300
key 10 up
wait 3000
expect launches >2
tap OCT+
wait 50
expect oct 3
tap OCT-
tap OCT-
tap OCT-
tap OCT-
wait 50
expect oct 0
tap OCT-
wait 50
expect oct 0
# REC: the weather held: the day stands still
tap REC
wait 100
expect hold 1
expect pos <5000
wait 120000
expect phase 2
expect pos <5000
shot hold.png
tap REC
wait 100
expect hold 0
# ALGORITHM: Ambience, from any page
tap HOME
spin ALGO -20
wait 200
expect par8 34
# SAVE held: the hill back to its recipe
press SAVE
wait 1800
release SAVE
wait 100
expect par0 50
expect par2 45
expect par8 34
