# a first look and listen: it plays from power-on, with no touch: kites go up and sing; the pages; the help cards
wav first.wav
wait 300
expect playing 1
expect day 1
wait 8000
shot intro.png
expect launches >0
wait 60000
shot hill.png
expect kites >1
expect vu >5
wavstop
expect peak_db_max -1
expect peak_db_min -40
tap ENV
wait 100
expect view 1
shot line.png
tap GLO
wait 100
expect view 2
shot setup.png
turn SELECT -5 100
expect view 0
tap HOME
wait 100
expect view 0
# a help card: hold a button (it does not act)
press REC
wait 1200
shot help.png
release REC
wait 100
expect hold 0
# later in the day: the gusty evening, then easing
tap EDIT
wait 200
tap EDIT
wait 90000
expect phase 3
shot evening.png
tap EDIT
wait 60000
expect phase 4
shot dusk.png
