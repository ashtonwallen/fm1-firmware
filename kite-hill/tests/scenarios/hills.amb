# every hill makes sound: PRESETS steps through all twelve; each keeps its own settings
master 4096
wait 300
expect style 0
wait 20000
peakreset
wait 10000
expect peak_db_min -40
expect peak_db_max -1
shot hill-0.png
turn PRESET 1
wait 25000
expect style 1
peakreset
wait 10000
expect peak_db_min -40
expect peak_db_max -1
