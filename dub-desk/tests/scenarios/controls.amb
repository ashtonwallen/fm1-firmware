# the controls: the knobs, PLAY, EDIT (next riddim), REC (repeat), FX (throw), LFO (spring), the keys, the octave,
# ALGORITHM, SAVE held
master 4096
wait 2000
expect track 1
# the desk page's knobs: engineer, echo, time, bass
spin K1 10
spin K2 -10
spin K3 2
spin K4 30
wait 300
expect par0 65
expect par1 40
expect par2 3
expect par3 100
expect dirty 1
shot knobs.png
# the band page
tap ENV
spin K1 -20
wait 200
expect par4 50
# the room page: tempo follows at once
tap GLO
spin K3 6
wait 3000
expect par10 78
expect bpm 78
# PLAY: stopped, silence; again: it rolls on
tap PLAY
wait 2500
expect playing 0
peakreset
wait 1500
expect peak_db_max -70
shot stopped.png
tap PLAY
wait 3000
expect playing 1
# FX: a throw into the echo; LFO: the spring kicked (each is a move on the desk)
expect moves >0
tap FX
wait 500
wait 100
expect echofb >55
tap LFO
wait 100
# EDIT: the next riddim within a few seconds
tap EDIT
wait 14000
expect track 2
expect trackms <12000
# the keys play along, even stopped
tap PLAY
wait 3000
peakreset
key 10 down
wait 300
key 10 up
expect peak_db_min -50
tap OCT+
wait 50
expect oct 3
tap OCT-
tap OCT-
tap OCT-
tap OCT-
wait 50
expect oct 0
tap OCT-
wait 50
expect oct 0
tap PLAY
wait 500
# REC: repeat; the riddim plays on past its end
tap REC
wait 100
expect repeat 1
spin K4 -5
wait 200
expect par11 0
wait 300000
expect track 2
shot repeat.png
tap REC
wait 100
expect repeat 0
# ALGORITHM: tone, from any page
tap HOME
spin ALGO -20
wait 200
expect par9 35
# SAVE held: the style back to its recipe
press SAVE
wait 1800
release SAVE
wait 100
expect par0 55
expect par3 70
expect par9 55
