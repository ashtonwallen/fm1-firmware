# state survives a power-off: the style and its knobs, the keys' octave, and where the session is
master 4096
wait 500
turn PRESET 2
wait 300
expect style 2
spin K1 -12
spin K4 -20
tap OCT+
tap GLO
spin K4 1
wait 300
expect par0 43
expect par3 60
expect par11 2
tap SAVE
wait 300
expect dirty 0
reboot
wait 500
expect style 2
expect par0 43
expect par3 60
expect par11 2
expect oct 3
expect playing 1
expect slot0p0 55
# the session goes on: the next version after the one that was playing
expect track >1
# by itself: a change saves once the knobs rest, at a quiet moment (between versions), at most every 5 minutes
tap HOME
spin K1 3
wait 900000
expect dirty 0
expect store_writes >1
reboot
wait 500
expect style 2
expect par0 46
# where the session is: kept at most hourly
wait 3700000
reboot
wait 500
expect track >10
