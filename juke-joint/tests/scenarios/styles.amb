shot lamp-oil.png
# and round again to the first; each night keeps its own settings
turn PRESET 1
wait 3000
expect style 0
turn K1 -5
wait 200
expect par0 95
turn PRESET 1
wait 3000
expect style 1
expect par0 96
turn PRESET -1
wait 3000
expect style 0
expect par0 95
