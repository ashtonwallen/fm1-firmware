# the controls: the knobs, PLAY (a break), EDIT (the next tune), REC (keep blowing), the keys, the octave, ALGORITHM, SAVE held
master 4096
wait 2000
expect tune 1
# the band page's knobs: tempo, intensity, room, swing
spin K1 10
spin K2 -10
spin K3 4
spin K4 30
wait 300
expect par0 60
expect par1 45
expect par2 44
expect par3 85
expect dirty 1
shot knobs.png
# the mix page
tap ENV
spin K1 -20
wait 200
expect par4 55
# the organ page: drawbars, speaker, drive, percussion
tap LFO
spin K1 3
spin K2 1
spin K4 -2
wait 300
expect view 2
expect par8 3
expect par9 2
expect par11 0
shot organ.png
# PLAY: the band takes a break, silence; again: it plays on
tap PLAY
wait 2500
expect playing 0
peakreset
wait 1500
expect peak_db_max -70
shot break.png
tap PLAY
wait 3000
expect playing 1
# EDIT: the next tune within a few seconds
tap EDIT
wait 4500
expect tune 2
expect phase 0
# the keys play along, even on a break
tap PLAY
wait 3000
peakreset
key 10 down
wait 300
key 10 up
expect peak_db_min -50
tap OCT+
wait 50
expect oct 3
tap OCT-
tap OCT-
tap OCT-
tap OCT-
wait 50
expect oct 0
tap OCT-
wait 50
expect oct 0
tap PLAY
wait 500
# REC: keep blowing; the tune goes on well past its length
tap REC
wait 100
expect repeat 1
tap GLO
spin K3 -5
wait 200
expect par14 0
wait 900000
expect tune 2
shot blowing.png
tap REC
wait 100
expect repeat 0
wait 600000
expect tune >2
# ALGORITHM: tone, from any page
tap HOME
spin ALGO -20
wait 200
expect par12 35
# SAVE held: the band back to its recipe
press SAVE
wait 1800
release SAVE
wait 100
expect par0 50
expect par3 55
