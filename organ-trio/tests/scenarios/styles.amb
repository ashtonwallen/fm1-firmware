# every band makes sound: PRESETS steps through all thirteen; each starts a new tune within seconds
master 4096
wait 300
expect style 0
peakreset
wait 12000
expect peak_db_min -40
expect peak_db_max -1
turn PRESET 1
wait 12000
expect style 1
peakreset
wait 10000
expect peak_db_min -40
expect peak_db_max -1
shot band1.png
turn PRESET 1
wait 12000
expect style 2
