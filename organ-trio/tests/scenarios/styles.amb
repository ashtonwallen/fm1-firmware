# and round again to the first; each band keeps its own settings
turn PRESET 1
wait 3000
expect style 0
turn K2 -5
wait 200
expect par1 50
turn PRESET 1
wait 3000
expect style 1
expect par1 60
turn PRESET -1
wait 3000
expect style 0
expect par1 50
