# every preset makes sound: PRESETS steps through all twelve; each keeps its own settings
master 4096
wait 300
expect style 0
peakreset
wait 20000
expect peak_db_min -40
expect peak_db_max -1
turn PRESET 1
wait 15000
expect style 1
peakreset
wait 15000
expect peak_db_min -40
expect peak_db_max -1
shot preset-1.png
turn PRESET 1
wait 15000
expect style 2
peakreset
wait 15000
expect peak_db_min -40
expect peak_db_max -1
shot preset-2.png
turn PRESET 1
wait 15000
expect style 3
peakreset
wait 15000
expect peak_db_min -40
expect peak_db_max -1
shot preset-3.png
