shot preset-11.png
# and round again to the first; each keeps its own settings
turn PRESET 1
wait 3000
expect style 0
spin K1 -5
wait 200
expect par0 40
turn PRESET 1
wait 3000
expect style 1
expect par0 24
turn PRESET -1
wait 3000
expect style 0
expect par0 40
