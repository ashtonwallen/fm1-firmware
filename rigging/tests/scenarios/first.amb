# a first look and listen: it plays from power-on, with no touch; the pages; the help cards
wav first.wav
wait 300
expect playing 1
wait 8000
shot intro.png
wait 30000
shot ship.png
expect onsets >2
expect vu >3
wavstop
expect peak_db_max -1
expect peak_db_min -40
tap ENV
wait 100
expect view 1
shot rig.png
tap GLO
wait 100
expect view 2
shot setup.png
turn SELECT -5 100
expect view 0
tap HOME
wait 100
expect view 0
# a help card: hold a button
press REC
wait 1200
shot help.png
release REC
wait 100
expect hold 0
wait 3000
shot later.png
