# the Ambience (Space page, knob 4): the preset's air (rain, wind, sea, candles) from silent to 120 %, 100 % the preset
# as it was; kept per preset. Measured while the choir rests (the air goes on): the default, off, full
tap PLAY
wait 300
expect playing 0
tap FX
expect preset 0
expect amb 20
expect eff37 0
spin K4 -3
expect eff37 0
spin K4 3
turn PRESET 1
expect preset 1
expect amb 20
expect eff37 0
spin K4 -3
expect eff37 0
spin K4 3
turn PRESET 1
expect preset 2
expect amb 20
expect eff37 35
wait 6000
peakreset
wait 4000
expect peak_db_min -50
expect peak_db_max -20
spin K4 -30
expect amb 0
expect eff37 0
wait 6000
peakreset
wait 4000
expect peak_db_max -55
spin K4 30
expect amb 24
expect eff37 42
wait 6000
peakreset
wait 4000
expect peak_db_min -48
