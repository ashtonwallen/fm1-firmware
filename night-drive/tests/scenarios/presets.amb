# every preset makes sound: each one in turn, 25 s, its peak above -30 dBFS and below -3; a screenshot of each
wait 300
expect preset 0
wait 25000
expect peak_db_min -30
expect peak_db_max -3
shot p00.png
peakreset
turn PRESET 1
expect preset 1
expect section 0
wait 25000
expect peak_db_min -30
expect peak_db_max -3
shot p01.png
peakreset
