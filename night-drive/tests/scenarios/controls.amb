# the controls: the Road page's four knobs, Setup's, the pages, the key (keys, OCT-/OCT+, MIDI), the chords (ALGO),
# the next section (EDIT), a key change (REC), the arpeggio (ARP), PLAY, the help cards, SAVE held (the recipe)
wait 300
expect view 0
spin K1 5
expect speed 105
spin K2 -10
expect bright 40
spin K3 -60
expect arp 0
spin K3 30
expect arp 30
spin K4 20
expect drift 60
shot road.png
# Setup
tap GLO
expect view 1
spin K1 -20
expect drums 50
spin K2 -60
expect leadlvl 0
spin K3 1
expect leds 2
spin K4 1
expect usb 1
expect usb_audio_full 1
shot setup.png
spin K4 -1
expect usb_audio_full 0
spin K3 -1
tap HOME
expect view 0
turn SELECT 1
expect view 1
turn SELECT -1
expect view 0
# HOME held, SELECT: the speed
press HOME
turn SELECT 3
release HOME
expect speed 108
expect view 0
# a key: the key, on the next bar (key 4 is A)
tapkey 4
expect home 9
wait 3000
expect key 9
tap OCT+
expect home 10
wait 3000
expect key 10
tap OCT-
tap OCT-
expect home 8
midi 90 3E 64
expect home 2
wait 3000
expect key 2
# ALGO: the progression
expect prog 0
turn ALGO 1
expect prog 1
wait 3000
expect engprog 1
turn ALGO -2
expect prog 7
# EDIT: the next section, on the next bar
expect section 0
tap EDIT
wait 3000
expect section 1
# REC: a key change of its own, on the next bar
expect keychanges 3
tap REC
wait 3000
expect keychanges 4
# ARP: the next pattern
expect arppat 0
tap ARP
wait 100
expect arppat 1
# PLAY: parked, and driving again
tap PLAY
wait 100
expect playing 0
shot parked.png
wait 6000
peakreset
wait 2000
expect peak_db_max -50
tap PLAY
wait 3000
expect playing 1
expect peak_db_min -40
# a help card: SAVE held a moment; let go, nothing else happens
press SAVE
wait 1000
expect help 8
shot help.png
release SAVE
expect help 0
expect store_writes 0
# SAVE held on: the preset back to its recipe (not saved)
press SAVE
wait 1700
release SAVE
expect speed 100
expect bright 50
expect drift 40
expect store_writes 0
tap SAVE
expect store_writes 1
expect dirty 0
# the battery in the header
battery 1
wait 100
shot battery.png
battery 4
wait 100
expect battery 4
