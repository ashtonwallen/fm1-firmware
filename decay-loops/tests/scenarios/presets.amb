# every preset makes sound by itself: each from its own fresh loop, 25 s
wait 500
peakreset
wait 20000
expect preset 0
expect peak_db_min -30
expect peak_db_max -0.5
spin PRESET 1
wait 300
peakreset
wait 25000
expect preset 1
expect loops >0
expect peak_db_min -30
expect peak_db_max -0.5
