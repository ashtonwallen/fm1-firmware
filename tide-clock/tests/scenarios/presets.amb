# PRESETS (1.1): thirteen palettes for the coast. Each makes sound, none clips; switching keeps the world (the time,
# the weather, the day, the log); the preset is kept as a setting; 1.0's project (format 1) loads whole, as Harbour
wait 300
tap PLAY
expect setting 0
expect preset 0
settime 12 0
weather fog 600
expect fogs 1
expect logn 1
wait 1000
# Harbour
expect preset 0
wait 5000
peakreset
wait 25000
expect peak_db_max -1
expect peak_db_min -30
expect wx 1
expect fogs 1
expect logn 1
expect day 1
expect min >719
expect min <745
# Fjord
turn PRESET 1
expect preset 1
wait 5000
peakreset
wait 25000
expect peak_db_max -1
expect peak_db_min -30
expect wx 1
