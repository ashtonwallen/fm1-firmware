# the strings, the lead, the air: there in the palettes that ask for them (Kelp Forest: the strings pad, a lead)
expect par22 2
expect tgt34 >30
# round again, and back
turn PRESET 1
expect preset 0
expect tgt34 0
turn PRESET -1
expect preset 12
turn PRESET -10
expect preset 2
expect tgt30 >40
tap GLO
shot setup.png
tap HOME
# kept as a setting (5 minutes after the last save at most), with the world
wait 310000
expect dirty 0
reboot
wait 300
expect preset 2
expect fogs 1
tap PLAY
# 1.0's project: the world whole, the sound Harbour
weather wind 300
expect logtype 3
turn PRESET 3
expect preset 5
storev1
reboot
wait 300
expect format 2
expect preset 0
expect fogs 1
expect logtype 3
expect day 1
expect sea 5
tap PLAY
peakreset
wait 20000
expect peak_db_min -30
# and it saves as format 2
turn PRESET 1
tap SAVE
reboot
wait 300
expect format 2
expect preset 1
expect logtype 3
tap PLAY
# long runs at the loud ends: Gale Warning in a storm, Lighthouse Choir through the night (shimmer), never clipping
turn PRESET 6
expect preset 7
weather storm 600
wait 5000
peakreset
wait 600000
expect peak_db_max -0.3
expect peak_db_min -30
weather calm 600
settime 23 0
turn PRESET -2
expect preset 5
wait 5000
peakreset
wait 600000
expect peak_db_max -0.3
expect peak_db_min -40
expect fogs 1
